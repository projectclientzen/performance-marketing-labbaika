# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER ONLY, jangan pernah dipakai di client/browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== Meta Ads =====
META_ACCESS_TOKEN=your-meta-access-token

# ===== App =====
APP_TIMEZONE=Asia/Jakarta

# Semua variabel di atas harus diisi ulang di hosting (Vercel) juga — mereka
# tidak ikut ter-deploy dari file ini atau dari .env.local. Lihat README.md
# bagian "Deploy" untuk mana yang boleh terekspos ke browser dan mana yang
# server-only, plus cara cek GET /api/health kalau ada yang tidak beres.

# ===== Purchase CAPI (server only; outbound disabled by default) =====
META_CAPI_BRAND_ID=
META_CAPI_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
# Hermes pins a currently supported Graph API version and verifies event age.
META_CAPI_API_VERSION=
META_CAPI_MAX_EVENT_AGE_SECONDS=
META_CAPI_ROUTE_VERIFIED=false
META_CAPI_ALLOW_LIVE=false
META_CAPI_TEST_EVENT_CODE=
# Separate random scheduler credential, at least 32 characters.
CAPI_WORKER_SECRET=
